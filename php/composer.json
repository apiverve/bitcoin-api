        "apiverve",
        "bitcoin",
        "bitcoin price api",
        "btc price api",
        "bitcoin api",
        "bitcoin price",
        "btc price"
    ],
    "homepage": "https://apiverve.com/marketplace/bitcoin?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/bitcoin",
        "source": "https://github.com/apiverve/bitcoin-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {

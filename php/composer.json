{
    "name": "apiverve/bitcoin",
    "description": "Bitcoin Price is a simple tool for getting the current price of Bitcoin. It returns the current price, market cap, 24-hour trading volume, and 24-hour price change in any currency.",
    "version": "1.2.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "bitcoin",
        "bitcoin price",
        "bitcoin price api",
        "btc price",
        "btc price api",
        "bitcoin market cap"
    ],
    "homepage": "https://bitcoin.apiverve.com?utm_source=php&utm_medium=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/bitcoin",
        "source": "https://github.com/apiverve/bitcoin-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Bitcoin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Bitcoin\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
